{
  "name": "mcpwarden",
  "version": "0.1.0",
  "description": "A policy-checkable MCP workflow runtime with safe tool discovery, approval planning, and a local service API.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "bin": {
    "mcpw": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "examples",
    "docs",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gravitied/mcp-workflow-ir-runtime.git"
  },
  "homepage": "https://github.com/Gravitied/mcp-workflow-ir-runtime#readme",
  "bugs": {
    "url": "https://github.com/Gravitied/mcp-workflow-ir-runtime/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "workflow",
    "policy",
    "agent-runtime",
    "tool-safety"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "check": "pnpm build && pnpm lint",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e",
    "test:package": "vitest run tests/e2e/package-smoke.test.ts",
    "release:check": "pnpm check && pnpm test && pnpm test:package && pnpm audit --audit-level low",
    "bench": "vitest bench tests/bench",
    "cli": "tsx src/cli.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.0.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "commander": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.6.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.0.0"
  }
}
