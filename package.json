{
  "name": "mcp-workflow-ir-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mcpw": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm build && pnpm lint",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
