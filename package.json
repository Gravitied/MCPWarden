    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e",
    "bench": "vitest bench tests/bench",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.0.0",
    "commander": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.0.0"
  }
}
